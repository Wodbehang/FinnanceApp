<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/TVTransactoinName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:textSize="20sp"
        android:text="TransactoinName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/TVTransactoinDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Date: TransactoinDate"
        android:textSize="20sp"
        app:layout_constraintStart_toEndOf="@id/TVTransactoinName"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/TVTransactoinCatagory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="TransactoinCatagory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TVTransactoinName" />
    <TextView
        android:id="@+id/TVTransactoinAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Amount: TransactoinAmount"
        app:layout_constraintStart_toEndOf="@id/TVTransactoinCatagory"
        app:layout_constraintTop_toBottomOf="@id/TVTransactoinName" />
    <TextView
        android:id="@+id/TVTransactoinNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="TransactoinNote"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/TVTransactoinCatagory" />

    <Button
        android:id="@+id/BTNEdit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:text="Edit"
        android:backgroundTint="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/TVTransactoinNote" />

    <Button
        android:id="@+id/BTNDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="Delete"
        android:backgroundTint="@color/red"
        app:layout_constraintStart_toEndOf="@+id/BTNEdit"
        app:layout_constraintTop_toBottomOf="@+id/TVTransactoinNote" />



</androidx.constraintlayout.widget.ConstraintLayout>