<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditText
        android:id="@+id/ETTransactoinName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="TransactoinName"
        android:textSize="20sp"
        app:layout_constraintEnd_toStartOf="@+id/ETTransactoinDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/ETTransactoinDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Date: TransactoinDate"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ETTransactoinName"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/ETTransactoinCatagory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="TransactoinCatagory"
        app:layout_constraintEnd_toStartOf="@+id/ETTransactoinAmount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ETTransactoinName" />

    <EditText
        android:id="@+id/ETTransactoinAmount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Amount: TransactoinAmount"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ETTransactoinCatagory"
        app:layout_constraintTop_toBottomOf="@id/ETTransactoinName" />

    <EditText
        android:id="@+id/ETTransactoinNote"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="TransactoinNote"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ETTransactoinCatagory" />

    <Button
        android:id="@+id/BTNSaveTransactionDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:text="Save"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ETTransactoinNote" />

    <CheckBox
        android:id="@+id/CBIsExpenseEditDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="Is Expense"
        app:layout_constraintBottom_toBottomOf="@+id/BTNSaveTransactionDialog"
        app:layout_constraintStart_toEndOf="@+id/BTNSaveTransactionDialog"
        app:layout_constraintTop_toTopOf="@+id/BTNSaveTransactionDialog" />

</androidx.constraintlayout.widget.ConstraintLayout>